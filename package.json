{
  "name": "one-round",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test game.test.cjs && node --import tsx --test game/rules.test.ts shared/protocol.test.ts amplify/functions/game-api/session.test.ts amplify/functions/event-auth/handler.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"{web,game,shared,amplify,scripts}/**/*.{ts,js}\" \"*.json\" \"vite.config.ts\"",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "ws": "^8.22.0"
  }
}
